{
  "name": "剧藏 · 网页试用",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {"ghcr.io/devcontainers/features/docker-in-docker:4": {}},
  "forwardPorts": [8080],
  "portsAttributes": {"8080": {"label": "剧藏 · 网页体验", "onAutoForward": "openBrowser"}},
  "postStartCommand": "python .devcontainer/start.py",
  "postAttachCommand": "python .devcontainer/welcome.py",
  "remoteUser": "vscode"
}
